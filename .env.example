# Environment Configuration Example
# Copy this file to .env and update with your values

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=False

# GPS Configuration
GPS_PORT=/dev/ttyACM0
GPS_BAUDRATE=38400

# IMU Configuration
IMU_PORT=/dev/ttyUSB0
IMU_BAUDRATE=115200
